{
    "name": "Strata.FrontEndController",
    "private": true,
    "scripts": {
        "remote-registry-config": "yarn config set registry https://registry.npmjs.org/",
        "local-registry-install": "yarn global add verdaccio",
        "local-registry-config": "yarn config set registry http://localhost:4873/",
        "local-registry-start": "verdaccio",
        "local-registry-init": "yarn run local-registry-install && yarn run local-registry-start && yarn run local-registry-config",
        "dev-init": "yarn --dev install",
        "clean-strata-frontendcontroller-service": "Components/Strata.FrontEndController.Service && yarn run clean",
        "clean-strata-frontendcontroller-client": "cd Components/Strata.FrontEndController.Client && yarn run clean",
        "clean-components": "yarn run clean-strata-frontendcontroller-service && yarn run clean-strata-frontendcontroller-client",
        "clean": "yarn run dev-init && yarn run clean-components",
        "deep-clean-strata-frontendcontroller-service": "cd Components/Strata.FrontEndController.Service && yarn run clean",
        "deep-clean-strata-frontendcontroller-client": "cd Components/Strata.FrontEndController.Client && yarn run clean",
        "deep-clean-components": "yarn run deep-clean-strata-frontendcontroller-service && yarn run deep-clean-strata-frontendcontroller-client",
        "deep-clean": "yarn run dev-init && yarn run deep-clean-components",
        "build-strata-frontendcontroller-service": "cd Components/Strata.FrontEndController.Service && yarn run publish-package",
        "build-strata-frontendcontroller-client": "cd Components/Strata.FrontEndController.Client && yarn run publish-package",
        "build-components": "yarn run build-strata-frontendcontroller-service && yarn run build-strata-frontendcontroller-client",
        "build": "yarn run dev-init && yarn run build-components",
        "test": "yarn run build"
    },
    "devDependencies": {
        "del-cli": "^5.1.0"
    }
}
